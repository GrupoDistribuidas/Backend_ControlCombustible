<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.57.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.57.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.20" />
    <PackageReference Include="Google.Protobuf" Version="3.23.4" />
    <PackageReference Include="Grpc.Tools" Version="2.57.0">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\MS.Autenticacion\Protos\auth.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\vehiculos.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\tipos.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\choferes.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\rutas.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\puntos.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\asignaciones.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\registroconsumo.proto" GrpcServices="Client" />
    <!-- Protos de Reportes -->
    <Protobuf Include="Protos\reportes-combustible.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\reportes-vehiculos.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\reportes-choferes.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\reportes-rutas.proto" GrpcServices="Client" />
    <!-- Protos de Reportes Avanzados -->
    <Protobuf Include="Protos\reportes-avanzados-combustible.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\reportes-avanzados-rutas.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
